# PayPal Developer dashboard > Apps & credentials > SANDBOX app
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Sandbox merchant (seller) email, from developer.paypal.com > Sandbox accounts
PAYPAL_MERCHANT_EMAIL=seller@sandbox.example.com
# Google AI Studio key for the evidence-review agent
GEMINI_API_KEY=your-gemini-key
# PayPal webhook id (developer.paypal.com > your app > webhooks) - required for signature verification
PAYPAL_WEBHOOK_ID=your-webhook-id
# Public base URL PayPal webhooks can reach (e.g. your tunnel/hosted URL)
PUBLIC_BASE_URL=https://your-public-url.example.com
# optional, default gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.1-flash-lite
